<Window x:Class="EmployeeFolderMaker.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ساخت پوشه‌های پرسنلی"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#EA580C" Padding="20,16">
            <StackPanel>
                <TextBlock Text="شرکت فروشگاه‌های زنجیره‌ای اتکا | معاونت منابع انسانی"
                           FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Text="نام، نام خانوادگی، کدملی، نوع عضویت و مسیر مقصد را وارد کنید."
                           Margin="0,6,0,0"
                           Foreground="#E0E7FF"/>
            </StackPanel>
        </Border>

        <!-- Card -->
        <Border Grid.Row="1" Margin="24"
                Background="White" CornerRadius="16" Padding="22">
            <Border.Effect>
                <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- row 0 -->
                    <RowDefinition Height="Auto"/>
                    <!-- row 1 -->
                    <RowDefinition Height="Auto"/>
                    <!-- row 2 (نوع عضویت) -->
                    <RowDefinition Height="Auto"/>
                    <!-- row 3 (checkbox) -->
                    <RowDefinition Height="*"/>
                    <!-- row 4 (info) -->
                    <RowDefinition Height="Auto"/>
                    <!-- row 5 (button) -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- نام -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="8">
                    <Label Content="نام"/>
                    <Border CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="2">
                        <TextBox x:Name="txtFirst" BorderThickness="0" Background="Transparent" />
                    </Border>
                </StackPanel>

                <!-- نام خانوادگی -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8">
                    <Label Content="نام خانوادگی"/>
                    <Border CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="2">
                        <TextBox x:Name="txtLast" BorderThickness="0" Background="Transparent" />
                    </Border>
                </StackPanel>

                <!-- کدملی -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="8">
                    <Label Content="کدملی"/>
                    <Border CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="2">
                        <TextBox x:Name="txtNid" BorderThickness="0" Background="Transparent" />
                    </Border>
                </StackPanel>

                <!-- مسیر مقصد + دکمه انتخاب -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8">
                    <Label Content="مسیر مقصد"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="2" Margin="0,0,8,0">
                            <TextBox x:Name="txtPath" BorderThickness="0" Background="Transparent" IsReadOnly="True" />
                        </Border>
                        <Button Grid.Column="1" x:Name="btnBrowse" Content="انتخاب مسیر..." Click="Browse_Click"/>
                    </Grid>
                </StackPanel>

                <!-- نوع عضویت -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="8">
                    <Label Content="نوع عضویت"/>
                    <Grid>
                        <Border CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Padding="2">
                            <ComboBox x:Name="cmbMembership" BorderThickness="0" Background="Transparent" SelectedIndex="0">
                                <!-- پیش‌فرض: رسمی -->
                                <ComboBoxItem Content="رسمی"/>
                                <ComboBoxItem Content="قراردادی"/>
                                <ComboBoxItem Content="سرباز وظیفه"/>
                            </ComboBox>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- چک‌باکس -->
                <CheckBox x:Name="chkOpenAfter"
                          Grid.Row="3" Grid.ColumnSpan="2" Margin="8,12,8,0"
                          FlowDirection="LeftToRight"
                          Content="پس از ایجاد، پوشه را باز کن" IsChecked="True"/>

                <!-- توضیحات کوچک -->
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="8,12"
                           Foreground="#6B7280" TextWrapping="Wrap"
                           Text="نام پوشه به صورت «نام-نام‌خانوادگی-کدملی-نوع‌عضویت» ساخته می‌شود. کاراکترهای غیرمجاز ویندوز به «-» تبدیل خواهند شد. برای «سرباز وظیفه» مجموعه پوشه‌های متفاوت ساخته می‌شود."/>

                <!-- دکمه ایجاد -->
                <Button Grid.Row="5" Grid.ColumnSpan="2" Height="44" Margin="8"
                        Content="ایجاد پوشه‌ها" Click="Create_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
